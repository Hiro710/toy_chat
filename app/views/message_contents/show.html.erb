<% provide(:title, @message_content.name) %>
<div class="box is-responsive show_content">
  <div class="content">

      <p>名前：<%= @message_content.name %></p>
      <p>性別：<%= @message_content.sex %></p>
      <p>気分：<%= @message_content.mood %></p>
      <p>好きなタイプ：<%= @message_content.person_type %></p>
      <p>【メッセージ】<br /><%= @message_content.content %></p>
      <p>投稿：<%= l @message_content.created_at %></p>
      <p>更新：<%= l @message_content.updated_at %></p>

      <div class="link_to_edit_btn">
        <% if @message_content.password_digest.present? && !post_verified?(@message_content.id) %>
          <%= link_to "編集", new_message_content_password_verification_path(@message_content), class: "button is-info" %>
        <% else %>
          <%= link_to "編集", edit_message_content_path(@message_content.id), class: "button is-info" %>
        <% end %>
      </div>

  </div>
</div>
